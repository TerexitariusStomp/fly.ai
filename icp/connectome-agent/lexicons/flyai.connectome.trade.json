{
  "lexicon": 1,
  "id": "flyai.connectome.trade",
  "defs": {
    "main": {
      "type": "record",
      "description": "Verifiable trade announcement — txHash proves it happened on-chain",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["tokenIn", "tokenOut", "amount", "txHash", "createdAt"],
        "properties": {
          "tokenIn": { "type": "string" },
          "tokenOut": { "type": "string" },
          "amount": { "type": "string" },
          "txHash": { "type": "string" },
          "rationale": { "type": "string", "maxLength": 2000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
